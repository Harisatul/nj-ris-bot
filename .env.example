# Generate: openssl rand -hex 32
MIMO_API_TOKEN=replace_with_a_long_random_token_at_least_24_chars
MIMO_OWNER_ID=me
LISTEN_ADDR=127.0.0.1:8080
# Copy from Neon dashboard. Use DIRECT endpoint for migration, pooled is fine for API.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Optional: Cloudflare R2, required only for photo/file upload
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mimo-media
MAX_UPLOAD_MB=15
# Optional: OpenAI-compatible embedding endpoint for semantic search
# Example: https://api.openai.com/v1/embeddings
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
